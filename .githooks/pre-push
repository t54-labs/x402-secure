#!/bin/bash
# Pre-push hook: print a documentation reminder, which never blocks the push,
# then run the pre-push hook this clone used before (if any) and return its
# exit status. Enable with scripts/install-git-hooks.sh.
# See AGENTS.md, "Keep documentation accurate".

push_input="$(cat)"

docs_reminder() {
  local zero=0000000000000000000000000000000000000000
  local _lref local_sha _rref remote_sha base changed="" ranges=""
  while read -r _lref local_sha _rref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$zero" ] && continue  # branch deletion
    if [ "$remote_sha" = "$zero" ]; then
      base="$(git merge-base origin/main "$local_sha" 2>/dev/null)" || continue
    else
      base="$remote_sha"
    fi
    git cat-file -e "$base^{commit}" 2>/dev/null || continue
    changed+="$(git diff --name-only "$base" "$local_sha" 2>/dev/null)"$'\n'
    ranges+="$base $local_sha"$'\n'
  done

  local code docs_changed
  code="$(printf '%s' "$changed" | grep -v -e '^$' -e '\.md$' -e '^docs/' | sort -u)"
  [ -z "$code" ] && return 0
  docs_changed="$(printf '%s' "$changed" | grep -e '\.md$' | sort -u)"

  # Names taken from the changed lines of source files, plus two lines of
  # context so a setting's name next to a changed default is included (tests,
  # generated files and lockfiles are skipped): CONSTANT_NAMES such as settings
  # and env vars, defined function/class names with an underscore or two
  # CamelCase words, quoted snake_case codes and event names, quoted URL paths,
  # and docs/*.md paths cited in those lines.
  local lines="" from to
  while read -r from to; do
    [ -z "$from" ] && continue
    lines+="$(git diff -U2 "$from" "$to" -- . ':(exclude)*.md' ':(exclude)docs/**' \
      ':(exclude)tests/**' ':(exclude)test/**' ':(exclude)**/test/**' ':(exclude)**/*.test.*' \
      ':(exclude)**/generated/**' ':(exclude)*.lock' ':(exclude)**/package-lock.json' 2>/dev/null \
      | grep -E '^[-+ ]' | grep -vE '^(\+\+\+|---) ')"$'\n'
  done <<< "$ranges"

  local names
  names="$( {
      printf '%s\n' "$lines" | grep -oE '\b[A-Z][A-Z0-9]*(_[A-Z0-9]+)+\b'
      printf '%s\n' "$lines" | sed -nE 's/.*(def|class|function|const|let|var|interface|type) +([A-Za-z_][A-Za-z0-9_]*).*/\2/p' \
        | grep -E '_|[a-z0-9][A-Z]'
      printf '%s\n' "$lines" | grep -oE "[\"'][a-z][a-z0-9]*(_[a-z0-9]+){2,}[\"']" | tr -d "\"'"
      printf '%s\n' "$lines" | grep -oE "[\"'][a-z][a-z0-9_]*\.[a-z][a-z0-9_.]*[\"']" | tr -d "\"'"
      printf '%s\n' "$lines" | grep -oE "[\"']/[A-Za-z0-9_{}.-]+/[A-Za-z0-9_{}/.-]*[\"']" | tr -d "\"'"
      printf '%s\n' "$lines" | grep -oE 'docs/[A-Za-z0-9_./-]+\.md'
    } | grep -v '^_' | awk 'length($0) >= 6' | sort -u | head -300 )"

  local related=""
  if [ -n "$names" ]; then
    # doc<TAB>names, ranked by how many distinct names each document mentions.
    related="$(git grep -o -F -f <(printf '%s\n' "$names") -- '*.md' \
        ':(exclude)docs/archive/**' \
        ':(exclude)AGENTS.md' ':(exclude)CLAUDE.md' 2>/dev/null \
      | awk -F: '{ doc = $1; name = substr($0, length(doc) + 2); key = doc SUBSEP name
                   if (!(key in seen)) { seen[key] = 1; n[doc]++; list[doc] = list[doc] (n[doc] > 1 ? ", " : "") name } }
                 END { for (d in n) printf "%d\t%s\t%s\n", n[d], d, list[d] }' \
      | sort -t "$(printf '\t')" -k1,1nr -k2,2 | cut -f2,3)"
    # cited paths ("docs/x.md") also match the cited document itself
    while read -r f; do
      [ -n "$f" ] || continue
      [ -f "$f" ] && related="$(printf '%s\n%s' "$related" "$f	(cited in the changed lines)")"
    done <<< "$(printf '%s\n' "$names" | grep -E '^docs/.*\.md$' | grep -v '^docs/archive/')"
    related="$(printf '%s\n' "$related" | grep -v '^$' | awk -F '\t' '!seen[$1]++')"
    if [ -n "$docs_changed" ] && [ -n "$related" ]; then
      related="$(printf '%s\n' "$related" | awk -F '\t' 'NR == FNR { skip[$0] = 1; next } !($1 in skip)' \
        <(printf '%s\n' "$docs_changed") -)"
    fi
  fi

  echo "Docs reminder: this push changes $(printf '%s\n' "$code" | wc -l | tr -d ' ') non-doc file(s) in:"
  printf '%s\n' "$code" | awk -F/ '{print (NF > 2 ? $1"/"$2 : $1)}' | sort -u | head -8 | sed 's/^/  - /'
  echo "  Markdown files changed in this push: $(printf '%s' "$docs_changed" | grep -c . | tr -d ' ')."
  if [ -n "$related" ]; then
    echo "  Documents not in this push that mention names from the changed lines:"
    printf '%s\n' "$related" | head -10 | awk -F '\t' '{ n = $2; if (length(n) > 90) n = substr(n, 1, 87) "..."; printf "    - %s (%s)\n", $1, n }'
    local n_related
    n_related="$(printf '%s\n' "$related" | grep -c .)"
    [ "$n_related" -gt 10 ] && echo "    ... and $((n_related - 10)) more"
  elif [ -n "$names" ]; then
    echo "  No other document mentions the $(printf '%s\n' "$names" | grep -c .) name(s) taken from the changed lines."
  fi
  echo "  The name search misses documents that describe the behavior in words (a default, a"
  echo "  limit, an error response). Check those too: fix what is now wrong, or archive it under"
  echo "  docs/archive/. If nothing is affected, add a 'Docs:' note to the PR description."
  echo "  (Reminder only; continuing.)"
}

printf '%s\n' "$push_input" | docs_reminder || true

previous="$(git config --get x402secure.previousPrePush 2>/dev/null || true)"
if [ -n "$previous" ] && [ -x "$previous" ] && [ "$previous" != "$0" ]; then
  printf '%s\n' "$push_input" | "$previous" "$@"
  exit $?
fi
exit 0
