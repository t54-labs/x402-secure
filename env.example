# x402-secure Environment Variables

# ========================================
# FOR BUYER AGENT DEVELOPERS
# ========================================

# Required: Your agent's private key (keep this secret!)
BUYER_PRIVATE_KEY=0x...

# Optional: OpenAI API key (if using OpenAI)
OPENAI_API_KEY=sk-...

# Network configuration
NETWORK=base-sepolia  # Use base-sepolia for testing, base for production

# Agent Gateway URL (where to send requests)
AGENT_GATEWAY_URL=http://localhost:8000

# Seller API URL (for demos)
SELLER_BASE_URL=http://localhost:8010

# ========================================
# FOR SELLER/API DEVELOPERS
# ========================================

# Where to receive payments
MERCHANT_PAYTO=0x...

# ========================================
# FOR SELF-HOSTING (Advanced)
# ========================================
# See docs/DEVELOPMENT.md for full configuration

# Proxy configuration
PROXY_HOST=0.0.0.0
PROXY_PORT=8000

# Risk mode
PROXY_LOCAL_RISK=1  # 1=local development, 0=production with Trustline

# Production mode (when PROXY_LOCAL_RISK=0)
# RISK_ENGINE_URL=<TRUSTLINE_API_URL>
# RISK_ENGINE_COMPAT=trustline  # Enable Trustline API compatibility layer
# RISK_INTERNAL_TOKEN=your_token  # Optional auth token
# TRUSTLINE_RETRY_AFTER_SECONDS=30  # Typed transient retry guidance

# VI receipt lookups (/internal/x402-secure/facilitator/vi-receipts/lookup) need a store
# that every worker shares. Without a reachable Redis, receipts are not stored and the
# lookup answers 503.
# X402_SECURE_VI_RECEIPT_REDIS_URL=redis://localhost:6379/0
# X402_SECURE_VI_RECEIPT_STORE=redis  # "memory": per process, single worker only (dev, tests)
# X402_SECURE_VI_RECEIPT_TTL_SECONDS=604800

# Upstream facilitator (default: x402.org)
PROXY_UPSTREAM_VERIFY_URL=https://x402.org/facilitator/verify
PROXY_UPSTREAM_SETTLE_URL=https://x402.org/facilitator/settle
