# Full Environment Configuration for Self-Hosting
# This file contains ALL possible configuration options
# For most users, see the simplified env.example

# ========================================
# Network Configuration
# ========================================
NETWORK=base-sepolia  # Options: base-sepolia (testnet), base (mainnet)

# ========================================
# Proxy Server Configuration
# ========================================
PROXY_HOST=0.0.0.0
PROXY_PORT=8000
PROXY_TIMEOUT_S=15
LOG_LEVEL=INFO  # run_facilitator_proxy.py log level

# Upstream facilitator configuration
PROXY_UPSTREAM_VERIFY_URL=https://x402.org/facilitator/verify
PROXY_UPSTREAM_SETTLE_URL=https://x402.org/facilitator/settle
# Required: /x402/verify and /x402/settle return 503 until this is at least 32 bytes
# (e.g. `openssl rand -hex 32`). Use the same secret on every replica.
PROXY_PAYMENT_AUTHORIZATION_KEY=

# Deployment-wide AP2/VI policy floor (JSON); see proxy/README.md
# PROXY_PUBLIC_MERCHANT_POLICY_JSON='{"ap2":{},"vi":{}}'

# Network chain ID mapping (JSON format)
# PROXY_NETWORK_CHAIN_MAP='{"base":8453,"base-sepolia":84532,"optimism":10}'

# Feature toggles
PROXY_SETTLE_RISK_ENABLED=0  # Run an additional risk check at settle

# ========================================
# Risk Engine Configuration
# ========================================
# Mode selection
PROXY_LOCAL_RISK=1  # 1=local in-memory, 0=external Trustline
# PROXY_LOCAL_RISK_TTL=900  # Lifetime in seconds of local-mode sessions and traces

# External risk engine (when PROXY_LOCAL_RISK=0)
# RISK_ENGINE_URL=<TRUSTLINE_API_URL>
# RISK_ENGINE_COMPAT=trustline  # Enable Trustline API compatibility layer
# RISK_INTERNAL_TOKEN=your_internal_token  # Optional auth token
# TRUSTLINE_RETRY_AFTER_SECONDS=30  # Retry-After guidance for the internal facilitator API only

# Internal facilitator API (/internal/x402-secure/facilitator/*);
# see proxy/README.md "Internal facilitator service scopes"
# X402_SECURE_INTERNAL_TOKEN=
# X402_SECURE_INTERNAL_TRUSTLINE_TOKEN=
# X402_SECURE_INTERNAL_ORGANIZATION=
# X402_SECURE_INTERNAL_ENVIRONMENT=
# X402_SECURE_INTERNAL_POLICY=
# X402_SECURE_INTERNAL_POLICY_VERSION=
# X402_SECURE_INTERNAL_ACTIONS=evaluate,evidence_session,evidence_upload,receipt_write
# X402_SECURE_INTERNAL_SERVICES_JSON=  # multiple services; replaces the single-service vars above
# TRUSTLINE_API_URL=<TRUSTLINE_API_URL>  # defaults to RISK_ENGINE_URL
# TRUSTLINE_VALIDATION_PREFIX=/api/v1/validation
# TRUSTLINE_TIMEOUT_S=15

# VI receipt lookups (/internal/x402-secure/facilitator/vi-receipts/lookup) need a store
# that every worker shares. Without a reachable Redis, receipts are not stored and the
# lookup answers 503.
# X402_SECURE_VI_RECEIPT_REDIS_URL=redis://localhost:6379/0
# X402_SECURE_VI_RECEIPT_STORE=redis  # "memory": per process, single worker only (dev, tests)
# X402_SECURE_VI_RECEIPT_REDIS_TIMEOUT_SECONDS=1  # connect and read timeout per operation
# X402_SECURE_VI_RECEIPT_TTL_SECONDS=604800

# ========================================
# Seller Configuration (for demos)
# ========================================
MERCHANT_PAYTO=0x000000000000000000000000000000000000dEaD
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e  # token offered in the 402 quote
SELLER_BASE_URL=http://localhost:8010
# Used only by scripts/create_wallets.py and scripts/check_balances.py:
SELLER_ADDRESS=0x0987654321098765432109876543210987654321
SELLER_PRIVATE_KEY=your_seller_private_key  # Optional

# ========================================
# Buyer Configuration (for demos)
# ========================================
BUYER_PRIVATE_KEY=your_buyer_private_key
BUYER_ADDRESS=your_buyer_address  # Optional; used only when no private key is configured
# Required by the buyer SDK examples: only pay this payee/asset, up to this atomic amount
BUYER_EXPECTED_PAY_TO=0x000000000000000000000000000000000000dEaD  # must equal MERCHANT_PAYTO
BUYER_EXPECTED_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e  # must equal USDC_ADDRESS
BUYER_MAX_AMOUNT_ATOMIC=100000

# ========================================
# Agent Configuration (for demos)
# ========================================
AGENT_GATEWAY_URL=http://localhost:8000
# X402_AGENT_TOOL_NS=  # Optional Python module run_agent_payment loads tool handlers from when no tools mapping is passed

# OpenAI integration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# OpenTelemetry (buyer SDK, setup_otel_from_env)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces  # OTLP export only when set
# OTEL_SERVICE_NAME=x402-buyer
# OTEL_CONSOLE_EXPORTER=1  # force console span output

# ========================================
# Development/Testing
# ========================================
# Local stub (bypass real facilitator): run packages/x402-secure/examples/upstream_stub.py
# and point PROXY_UPSTREAM_VERIFY_URL / PROXY_UPSTREAM_SETTLE_URL at it

# ========================================
# Token Addresses
# ========================================
# Base Sepolia testnet USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base mainnet USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ========================================
# Deployment Modes
# ========================================
# Mode 1 - Local Development:
#   PROXY_LOCAL_RISK=1
#   Features: Single process, in-memory storage
#
# Mode 2 - Production with Trustline:
#   PROXY_LOCAL_RISK=0
#   RISK_ENGINE_URL=<TRUSTLINE_API_URL>  # https only
#   RISK_ENGINE_COMPAT=trustline
#   RISK_INTERNAL_TOKEN=your_token  # Optional
#   Features: Full risk assessment, persistent storage
#
# Mode 3 - Custom Risk Engine:
#   PROXY_LOCAL_RISK=0
#   RISK_ENGINE_URL=https://your-risk-engine.com
#   Features: Your own risk implementation
